# Optional. Without these, the site uses KEP's live Supabase project and works
# out its own address from each request. Set them (in .env.local, or in Cloudflare
# under Workers & Pages → project-kingdomempplace → Settings → Variables and
# Secrets) only to point at a different project or pin the site address.

# Supabase project URL and publishable/anon key. Both are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Where the site is served from. Used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never put the Supabase service-role key in a NEXT_PUBLIC_ variable.
