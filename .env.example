# Copy to .env.local for local development. Set the same values in Cloudflare
# (Workers & Pages → kep-platform → Settings → Variables and Secrets).

# Supabase project URL and publishable/anon key. Both are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Where the site is served from. Used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never put the Supabase service-role key in a NEXT_PUBLIC_ variable.
